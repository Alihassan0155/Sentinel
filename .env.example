# Local database published by Docker Compose on port 5430.
DATABASE_URL=postgresql+psycopg://sentinel_user:sentinel_pass@localhost:5430/sentinel
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false

# Optional SMTP delivery; recipients come from the owning account's email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NOTIFICATION_TIMEZONE=Asia/Karachi
NOTIFICATION_COOLDOWN_MINUTES=180
